{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "blocks": {
      "items": {"$ref": "#/$defs/block"},
      "maxItems": 2,
      "minItems": 1,
      "type": "array"
    },
    "method": {"enum": ["menu", "open"]},
    "question": {"enum": ["S2", "S8", "S10"]},
    "slot": {"enum": ["M1", "M2", "M3", "O1", "O2", "O3"]}
  },
  "required": ["slot", "method", "question", "blocks"],
  "type": "object",
  "$defs": {
    "answer": {
      "additionalProperties": false,
      "properties": {
        "directions": {
          "items": {"$ref": "#/$defs/direction"},
          "type": "array"
        },
        "identity_evidence_span_id": {
          "pattern": "^[ABC]-E[0-9]{3}$",
          "type": ["string", "null"]
        },
        "identity_explicit": {"type": "boolean"}
      },
      "required": ["directions", "identity_explicit", "identity_evidence_span_id"],
      "type": "object"
    },
    "block": {
      "additionalProperties": false,
      "properties": {
        "answers": {
          "additionalProperties": false,
          "properties": {
            "A": {"$ref": "#/$defs/answer"},
            "B": {"$ref": "#/$defs/answer"},
            "C": {"$ref": "#/$defs/answer"}
          },
          "required": ["A", "B", "C"],
          "type": "object"
        },
        "block_id": {
          "pattern": "^S(2|8|10)-B(0[1-9]|1[0-9])$",
          "type": "string"
        },
        "comparisons": {
          "additionalProperties": false,
          "properties": {
            "A_vs_B": {"$ref": "#/$defs/comparison"},
            "A_vs_C": {"$ref": "#/$defs/comparison"},
            "B_vs_C": {"$ref": "#/$defs/comparison"}
          },
          "required": ["A_vs_B", "A_vs_C", "B_vs_C"],
          "type": "object"
        }
      },
      "required": ["block_id", "answers", "comparisons"],
      "type": "object"
    },
    "comparison": {
      "additionalProperties": false,
      "properties": {
        "math_focus": {"$ref": "#/$defs/verdict"},
        "nonmath_breadth": {"$ref": "#/$defs/verdict"}
      },
      "required": ["math_focus", "nonmath_breadth"],
      "type": "object"
    },
    "decisive_ref": {
      "additionalProperties": false,
      "properties": {
        "answer": {"enum": ["A", "B", "C"]},
        "local_id": {"pattern": "^d[0-9]+$", "type": "string"}
      },
      "required": ["answer", "local_id"],
      "type": ["object", "null"]
    },
    "direction": {
      "additionalProperties": false,
      "properties": {
        "definition": {"type": ["string", "null"]},
        "evidence_span_id": {
          "pattern": "^[ABC]-E[0-9]{3}$",
          "type": "string"
        },
        "local_id": {"pattern": "^d[0-9]+$", "type": "string"},
        "menu_id": {
          "pattern": "^S(2|8|10)-D[0-9]+$",
          "type": ["string", "null"]
        },
        "name": {"type": ["string", "null"]},
        "tag": {"enum": ["数学", "非数学", "无法归类"]}
      },
      "required": [
        "local_id",
        "menu_id",
        "name",
        "definition",
        "evidence_span_id",
        "tag"
      ],
      "type": "object"
    },
    "verdict": {
      "additionalProperties": false,
      "properties": {
        "choice": {"enum": ["A", "B", "C", "相当", "无法判断"]},
        "decisive": {"$ref": "#/$defs/decisive_ref"},
        "reason": {"minLength": 1, "type": "string"}
      },
      "required": ["choice", "reason", "decisive"],
      "type": "object"
    }
  }
}
